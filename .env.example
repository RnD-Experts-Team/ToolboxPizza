APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toolboxpizza
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Central auth (pizzasys). There is no local login: every API request is
# verified against this server, which must also hold an auth-rule row for each
# route or ext.authorized comes back false and everything 403s.
# AUTH_SERVER_SERVICE_NAME must match the `service` string the dashboard uses
# in canAccessRoute({ service: ... }).
# ---------------------------------------------------------------------------
AUTH_SERVER_BASE_URL=http://auth-service.local
AUTH_SERVER_VERIFY_PATH=/api/v1/auth/token/verify
AUTH_SERVER_SERVICE_NAME=Toolbox
AUTH_SERVER_CALL_TOKEN=
AUTH_SERVER_TIMEOUT=3
AUTH_SERVER_RETRIES=1
AUTH_SERVER_RETRY_MS=100
AUTH_SERVER_CACHE_TTL=30

# ---------------------------------------------------------------------------
# NATS JetStream. Users arrive here over auth.v1.user.* — a user who has not
# replicated yet gets 401 'user not synced yet', so `php artisan nats:consume`
# needs to run supervised. Streams and durable consumers are created manually
# via the NATS CLI; see config/nats.php for the exact commands.
# DEV_MODE=1 swaps every subject for its *.testing.v1.* twin.
# ---------------------------------------------------------------------------
DEV_MODE=0
NATS_HOST=127.0.0.1
NATS_PORT=4222
NATS_USER=
NATS_PASS=
NATS_TOKEN=
NATS_PULL_BATCH=25
NATS_PULL_TIMEOUT_MS=2000
NATS_PULL_SLEEP_MS=250

# ---------------------------------------------------------------------------
# Toolbox — breaks
# A work day runs cutoff->cutoff UTC and a break belongs to the day it STARTED
# in. Changing the cutoff is NOT retroactive (work_date is stored), so change
# it on a quiet day and let 30-day retention age out the inconsistency.
# ---------------------------------------------------------------------------
TOOLBOX_WORK_DAY_CUTOFF_HOUR=6
TOOLBOX_WORK_DAY_TIMEZONE=UTC
TOOLBOX_DEFAULT_ALLOWANCE_MINUTES=50
TOOLBOX_BREAK_RETENTION_DAYS=30
TOOLBOX_MAX_MILESTONES=10

# Milestone crossings are recorded either way; this only decides whether a
# notification envelope is written to the outbox for them. TURNING THIS ON MUST
# BE PAIRED with scheduling breaks:evaluate-milestones — see routes/console.php.
TOOLBOX_NOTIFICATIONS_ENABLED=false
TOOLBOX_BREAKS_ACTION_URL=/toolbox/breaks

# Live break state pushed to the user's socket over NotificationsPizza's Reverb,
# on the private-users.{id} channel the dashboard already holds. No Reverb here.
#
# DEPLOY ORDERING: the transport is notifications.v1.broadcast.send, which
# NotificationsPizza only handles once its BroadcastSendHandler is deployed.
# Enabling this first makes that service's consumer throw on an unknown subject
# and park the messages. Deploy NotificationsPizza, then flip this.
TOOLBOX_REALTIME_ENABLED=false
